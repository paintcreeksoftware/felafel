# node-linker=hoisted lays node_modules out in the classic flat style instead
# of pnpm's default deeply-nested "isolated" layout. Required for Electron +
# pnpm because electron-builder walks node_modules to figure out what to ship
# in the installer and gets lost in the isolated layout
# (electron-userland/electron-builder#9654). Standard recommendation for
# Electron + pnpm projects.
node-linker=hoisted

# manage-package-manager-versions makes pnpm self-bootstrap to the version
# pinned in package.json's `packageManager` field. Whatever pnpm a contributor
# happens to have installed, the first command they run in this repo will
# download and switch to the project's pnpm version automatically. Single
# source of truth for the pnpm version is package.json — distrobox.ini and
# anywhere else just install "any pnpm".
manage-package-manager-versions=true
