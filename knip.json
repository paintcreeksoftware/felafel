{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": [
    "shellcheck"
  ],
  "workspaces": {
    "apps/storybook": {
      "entry": [
        ".storybook/main.ts",
        ".storybook/preview.tsx",
        "src/stories/**/*.stories.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}", ".storybook/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "tailwindcss"
      ]
    },
    "apps/desktop": {
      "entry": [
        "electron.vite.config.ts",
        "src/main/index.ts",
        "src/main/pino-roll.d.ts",
        "src/preload/index.ts",
        "src/renderer/src/main.tsx",
        "tests/**/*.{test,spec}.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "@felafel/ui",
        "tailwindcss"
      ]
    },
    "apps/orchestrator": {
      "entry": ["tests/**/*.{test,spec}.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"],
      "ignoreDependencies": [
        "@opentelemetry/auto-instrumentations-node",
        "@opentelemetry/exporter-trace-otlp-http",
        "@opentelemetry/resources",
        "@opentelemetry/sdk-node",
        "pino"
      ]
    },
    "apps/worker": {
      "entry": ["tests/**/*.{test,spec}.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"],
      "ignoreDependencies": [
        "@opentelemetry/auto-instrumentations-node",
        "@opentelemetry/exporter-trace-otlp-http",
        "@opentelemetry/resources",
        "@opentelemetry/sdk-node",
        "pino"
      ]
    },
    "packages/backend": {
      "entry": ["tests/**/*.{test,spec}.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/contracts": {
      "entry": ["tests/**/*.{test,spec}.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/db": {
      "entry": ["tests/**/*.{test,spec}.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/logs": {
      "entry": ["tests/**/*.{test,spec}.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"],
      "ignoreDependencies": [
        "pino-pretty"
      ]
    },
    "packages/shared": {
      "entry": ["tests/**/*.{test,spec}.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"],
      "ignoreDependencies": [
        "electron"
      ]
    },
    "packages/tailscale": {
      "entry": [
        "src/ui/window.d.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/ui": {
      "ignore": ["**"]
    }
  }
}
