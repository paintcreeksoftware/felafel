{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/desktop": {
      "entry": [
        "electron.vite.config.ts",
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/renderer/src/main.tsx",
        "tests/**/*.{test,spec}.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
    },
    "apps/orchestrator": {
      "entry": ["tests/**/*.{test,spec}.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "apps/worker": {
      "entry": ["tests/**/*.{test,spec}.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/contracts": {
      "entry": ["tests/**/*.{test,spec}.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/db": {
      "entry": ["tests/**/*.{test,spec}.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/ui": {
      "ignore": ["**"]
    }
  }
}
