{
  "name": "@felafel/orchestrator",
  "version": "0.0.0",
  "private": true,
  "description": "Hono service that registers workers and exposes them over a typed REST API. Spawned by the desktop main process in embedded mode; shipped as a Docker image in container mode.",
  "type": "module",
  "main": "./dist/index.mjs",
  "exports": {
    ".": "./dist/index.mjs",
    "./app": "./src/app.ts",
    "./constants": "./src/constants.ts",
    "./dispatch": "./src/dispatch.ts",
    "./routes/*": "./src/routes/*.ts",
    "./sweep": "./src/sweep.ts"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "lint": "eslint . --max-warnings=0",
    "format": "oxfmt",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "package": "cd ../.. && docker build -f apps/orchestrator/Dockerfile -t felafel-orchestrator ."
  },
  "dependencies": {
    "@felafel/backend": "workspace:*",
    "@felafel/db": "workspace:*",
    "@felafel/logs": "workspace:*",
    "@felafel/shared": "workspace:*",
    "@hono/node-server": "^1.18.0",
    "@hono/zod-openapi": "^1.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "hono": "^4.10.0",
    "pathe": "^2.0.0",
    "pino": "^10.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
