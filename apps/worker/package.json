{
  "name": "@felafel/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Worker daemon: self-registers with the orchestrator, exposes a Hono server for orchestrator-dispatched jobs over Tailnet, and heartbeats every 30s.",
  "type": "module",
  "main": "./dist/index.mjs",
  "exports": {
    ".": "./dist/index.mjs",
    "./app": "./src/app.ts",
    "./constants": "./src/constants.ts",
    "./heartbeat": "./src/heartbeat.ts",
    "./hosts": "./src/hosts.ts",
    "./identity": "./src/identity.ts",
    "./routes/*": "./src/routes/*.ts",
    "./shutdown": "./src/shutdown.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@felafel/shared": "workspace:*",
    "@felafel/tailscale": "workspace:*",
    "@hono/node-server": "^1.18.0",
    "@hono/zod-openapi": "^1.1.0",
    "hono": "^4.10.0",
    "p-retry": "^8.0.0",
    "pathe": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
