{
  "name": "@felafel/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "The Electron desktop app — main, preload, and renderer in one package, plus an embedded PocketBase sidecar. electron-vite handles dev/build; electron-builder packages it.",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/download-pocketbase.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "prepackage": "node scripts/download-pocketbase.mjs --all-platforms",
    "package": "electron-builder --config electron-builder.yml",
    "lint": "oxlint",
    "format": "oxfmt",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@felafel/shared": "workspace:*",
    "get-port": "^7.2.0",
    "pocketbase": "^0.26.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.2"
  }
}
