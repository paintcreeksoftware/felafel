{
  "name": "@felafel/desktop",
  "productName": "Felafel",
  "version": "0.0.0",
  "private": true,
  "description": "The Electron desktop app — main, preload, and renderer in one package, plus an embedded PocketBase sidecar. electron-vite handles dev/build; electron-builder packages it.",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/download-pocketbase.mjs",
    "dev": "pnpm --filter @felafel/orchestrator build && electron-vite dev",
    "build": "electron-vite build",
    "prepackage": "node scripts/download-pocketbase.mjs --all-platforms",
    "package": "electron-builder --config electron-builder.yml",
    "lint": "oxlint",
    "format": "oxfmt",
    "check-types": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@felafel/shared": "workspace:*",
    "@felafel/ui": "workspace:*",
    "get-port": "^7.2.0",
    "pocketbase": "^0.26.8",
    "which": "^6.0.1"
  },
  "devDependencies": {
    "@felafel/orchestrator": "workspace:*",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/which": "^3.0.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "41.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.2"
  }
}
