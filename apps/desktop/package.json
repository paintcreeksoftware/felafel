{
  "name": "@felafel/desktop",
  "productName": "Felafel",
  "version": "0.0.0",
  "private": true,
  "author": "Paint Creek Software",
  "description": "The Electron desktop app — main, preload, and renderer in one package, with an embedded orchestrator (Hono) sidecar. electron-vite handles dev/build; electron-builder packages it.",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "pnpm --filter @felafel/orchestrator build && electron-vite dev",
    "build": "pnpm --filter @felafel/orchestrator build && electron-vite build",
    "package": "electron-builder --config electron-builder.yml",
    "lint": "eslint . --max-warnings=0",
    "format": "oxfmt",
    "check-types": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@felafel/backend": "workspace:*",
    "@felafel/logs": "workspace:*",
    "@felafel/shared": "workspace:*",
    "@felafel/tailscale": "workspace:*",
    "@felafel/ui": "workspace:*",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/sdk-trace-web": "^2.7.1",
    "execa": "^9.6.1",
    "get-port": "^7.2.0",
    "hono": "^4.10.0",
    "p-retry": "^8.0.0",
    "pathe": "^2.0.0"
  },
  "devDependencies": {
    "@felafel/orchestrator": "workspace:*",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "41.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.2"
  }
}
