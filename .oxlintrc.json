{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "ignorePatterns": ["packages/ui/**"],
  "env": {
    "node": true,
    "browser": true,
    "es2022": true,
    "vitest": true
  },
  "plugins": [
    "import",
    "typescript",
    "react",
    "react-perf",
    "jsx-a11y",
    "unicorn",
    "promise",
    "node",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "perf": "error",
    "suspicious": "error",
    "pedantic": "error",
    "style": "error",
    "nursery": "error"
  },
  "rules": {
    "import/no-duplicates": "error",
    "import/first": "error",
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "import/consistent-type-specifier-style": ["error", "prefer-inline"],
    "no-restricted-imports": ["error", {
      "patterns": [
        { "group": ["./*", "../*"], "message": "Use the @felafel/<pkg>/... alias, not relative paths." },
        { "group": ["*.js"], "message": "Drop the .js extension; bundler resolution handles it." }
      ]
    }],
    "no-magic-numbers": ["error", {
      "ignore": [-1, 0, 1, 2],
      "ignoreArrayIndexes": true,
      "ignoreDefaultValues": true,
      "ignoreClassFieldInitialValues": true,
      "enforceConst": true
    }],

    "react/react-in-jsx-scope": "off",
    "react/jsx-props-no-spreading": "off",
    "react/jsx-max-depth": "off",
    "react-perf/jsx-no-new-object-as-prop": "off",
    "react-perf/jsx-no-new-function-as-prop": "off",
    "no-nodejs-modules": "off",

    "sort-keys": "off",
    "sort-imports": "off",
    "func-style": "off",
    "no-named-export": "off",
    "prefer-default-export": "off",
    "no-ternary": "off",
    "no-null": "off",
    "id-length": "off",
    "max-lines": "off",
    "max-lines-per-function": "off",
    "max-statements": "off",
    "max-params": "off",
    "group-exports": "off",
    "exports-last": "off",
    "no-underscore-dangle": "off",
    "no-inline-comments": "off",
    "filename-case": "off",

    "capitalized-comments": "off",
    "numeric-separators-style": "off",

    "avoid-new": "off",

    "prefer-global-this": "off",
    "no-await-in-loop": "off",
    "no-await-expression-member": "off",
    "no-continue": "off",
    "param-names": "off",
    "no-nesting": "off",
    "no-multiple-resolved": "off",
    "always-return": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.integration.test.ts", "**/*.spec.ts", "**/*.config.ts", "**/*.config.js"],
      "rules": {
        "import/first": "off",
        "no-magic-numbers": "off",
        "init-declarations": "off"
      }
    },
    {
      "files": ["apps/desktop/src/renderer/src/main.tsx"],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    }
  ]
}
