{
  "name": "felafel",
  "version": "1.0.0",
  "private": true,
  "description": "Electron desktop application built on Turborepo with an embedded Hono orchestrator service.",
  "keywords": [],
  "license": "MIT",
  "author": "Paint Creek Software",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "package": "turbo run package",
    "lint": "turbo run lint && pnpm lint:root",
    "lint:root": "eslint --max-warnings=0 commitlint.config.mjs eslint.config.mjs eslint scripts",
    "format": "turbo run format",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#**/node_modules\" \"#**/out\" \"#**/release\" \"#**/dist\" \"#**/test-results\" \"#**/playwright-report\"",
    "lint:sh": "shellcheck setup.sh .husky/pre-commit .husky/commit-msg scripts/*.sh",
    "lint:exports": "node scripts/check-export-coverage.mjs",
    "knip": "knip",
    "cost:report": "bash scripts/cost.sh",
    "cost:since": "bash scripts/cost.sh --since",
    "post-merge:sync": "bash scripts/post-merge-memory-sync.sh",
    "pr:ready": "bash scripts/pr-ready.sh",
    "prune:branches": "bash scripts/prune-stale-branches.sh",
    "db:check": "pnpm --filter @felafel/db db:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/node": "^24.12.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.3.0",
    "eslint-plugin-better-tailwindcss": "^4.5.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "husky": "^9.1.7",
    "knip": "^6.11.0",
    "markdownlint-cli2": "^0.22.1",
    "oxfmt": "^0.47.0",
    "turbo": "^2.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  }
}
