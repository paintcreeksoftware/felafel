#!/usr/bin/env sh

set -e

# devcontainer-lock.json must move in lockstep with devcontainer.json. If the
# JSON is staged but the lock has unstaged changes, you almost certainly
# rebuilt the container and forgot to `git add` the regenerated lock.
if git diff --cached --name-only | grep -qE '^\.devcontainer/devcontainer\.json$'; then
  lock=.devcontainer/devcontainer-lock.json
  if ! git diff --cached --name-only | grep -qE "^${lock}$"; then
    if [ -f "$lock" ] && ! git diff --quiet -- "$lock"; then
      echo "ERROR: devcontainer.json is staged but $lock has unstaged changes."
      echo "Stage the lock alongside the JSON:"
      echo "  git add $lock"
      exit 1
    fi
  fi
fi

# Reject commits whose net reviewable churn exceeds the project's hard cap.
# Soft target is 50 lines; hard cap is 100. Lockfiles are excluded via
# pathspec so rename detection still works. `-M70%` lets a file rename
# count as the actual import-line diff instead of the full add+delete.
# There is no bypass — split the commit along the smallest behavioral
# delta. ALLOW_BIG_COMMIT used to provide a 2-per-PR escape hatch; it
# was removed because it was being reached for too readily.
cap=100
exclude_lockfiles=":(exclude)pnpm-lock.yaml :(exclude)package-lock.json :(exclude)yarn.lock :(exclude).devcontainer/devcontainer-lock.json"
# shellcheck disable=SC2086 # word-splitting is intentional — one pathspec per arg
stat=$(git diff --cached --shortstat -M70% -- $exclude_lockfiles)
inserts=$(echo "$stat" | grep -oE '[0-9]+ insertion' | grep -oE '[0-9]+' || echo 0)
deletes=$(echo "$stat" | grep -oE '[0-9]+ deletion'  | grep -oE '[0-9]+' || echo 0)
inserts=${inserts:-0}
deletes=${deletes:-0}
total=$((inserts + deletes))
if [ "$total" -gt "$cap" ]; then
  echo "ERROR: commit is ${total} lines (insertions+deletions, lockfiles excluded, renames detected). Hard cap is ${cap}."
  echo "Soft target is 50 lines; split along the smallest behavioral delta."
  echo "There is no bypass — split the commit."
  exit 1
fi

pnpm lint
pnpm check-types
pnpm test
pnpm lint:md
pnpm lint:sh
# `db:check` fails if the Drizzle schema in @felafel/contracts has diverged
# from the committed migrations under packages/db/migrations/. Catches the
# "edited schema, forgot to run `db:generate`" failure mode locally before
# push (and again in CI — see .github/workflows/lint.yml).
pnpm db:check
# `lint:exports` catches `@felafel/<pkg>/<sub-path>` imports that aren't
# declared in the target package's package.json#exports. tsc resolves
# them via the tsconfig `paths` block at typecheck time; the bundler
# resolves via `exports` at build time — they're free to drift, and they
# did on PAI-139 #57. See PAI-143.
pnpm lint:exports
# `knip` catches dead exports, dead files, and unlisted dependencies
# (imports from packages not in the consuming workspace's package.json).
# Same coverage as CI's knip job — running it locally too shifts the
# catch left so a "forgot to `pnpm --filter <pkg> add <dep>`" miss is
# caught at commit time, not after the PR's CI build.
pnpm knip
