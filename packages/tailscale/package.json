{
  "name": "@felafel/tailscale",
  "version": "0.0.0",
  "private": true,
  "description": "Tailscale integration surface for Felafel: TailscaleManager (host `tailscale` CLI wrapper for status / up / serve), pure parsers + error classifiers, and the worker-side IPv4 resolver. The React pill component lives behind the ./ui sub-path so node consumers don't pay the React import cost.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants.ts",
    "./manager": "./src/manager.ts",
    "./ui": "./src/ui/index.ts",
    "./worker-ip": "./src/worker-ip.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "check-types": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'"
  },
  "dependencies": {
    "@felafel/shared": "workspace:*",
    "@felafel/ui": "workspace:*",
    "execa": "^9.6.1",
    "lucide-react": "^1.12.0",
    "p-retry": "^8.0.0",
    "which": "^6.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/which": "^3.0.4",
    "react": "19.2.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
