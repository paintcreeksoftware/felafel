// Node-side TypeScript: TailscaleManager (host `tailscale` CLI wrapper),
// the worker-side IPv4 resolver, the pure parsers / classifiers, and the
// shared constants. DOM and JSX deliberately excluded so a stray DOM
// reference from the node-side surface fails typecheck instead of slipping
// through.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "paths": { "@felafel/tailscale/*": ["./src/*"] },
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "vitest.config.ts"],
  "exclude": ["src/ui/**/*"]
}
