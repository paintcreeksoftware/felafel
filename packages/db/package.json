{
  "name": "@felafel/db",
  "version": "0.0.0",
  "private": true,
  "description": "Runtime persistence layer for the Felafel orchestrator. Wraps node:sqlite + Drizzle ORM behind a single createDb() entry point that opens the SQLite database, applies migrations from this package's migrations/ directory, and returns a typed Drizzle handle. Schema and wire-shape Zod come from @felafel/contracts. Workspace-only; never published.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./conversions": "./src/conversions.ts",
    "./queries/runs": "./src/queries/runs.ts",
    "./queries/workers": "./src/queries/workers.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "format": "oxfmt",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@felafel/contracts": "workspace:*",
    "drizzle-orm": "1.0.0-rc.2-33e80cd",
    "pathe": "^2.0.0"
  },
  "devDependencies": {
    "drizzle-kit": "1.0.0-rc.2-33e80cd",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
